# backend/.env — bu faylni nusxalab .env deb saqlang, haqiqiy qiymatlarni yozing.
# .env fayli HECH QACHON git'ga qo'shilmaydi (.gitignore'da bor).

ENV=local

# Supabase: Project Settings -> Database -> Connection string (URI, "Session pooler" emas, to'g'ridan-to'g'ri)
DATABASE_URL=postgresql://postgres:PAROLINGIZ@db.xxxxxxxx.supabase.co:5432/postgres

# JWT tokenlarni imzolash uchun maxfiy kalit. PRODUCTIONDA albatta uzun,
# tasodifiy qiymat bilan almashtiring (masalan quyidagi buyruq bilan
# yaratishingiz mumkin: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=mahalliy-sinov-uchun-xavfsiz-emas-kalit

# Frontend qaysi manzildan so'rov yuborishiga ruxsat berish (vergul bilan ajratib bir nechta yozish mumkin)
CORS_ORIGINS=*
